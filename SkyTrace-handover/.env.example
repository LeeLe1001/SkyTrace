# SkyTrace 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 生产环境务必修改所有密钥！

# ===== 数据库 =====
# SQLite（开发/单机）: 留空即可，自动创建 data/skytrace.db
# PostgreSQL（生产）: postgresql://user:pass@host:5432/skytrace
SKYTRACE_DATABASE_URL=

# ===== 安全密钥 =====
# Flask session 加密密钥（生产环境请用 openssl rand -hex 32 生成）
SKYTRACE_SECRET_KEY=
# 数据库字段加密密钥（用于加密 API key 和 GitHub token）
SKYTRACE_ENCRYPTION_KEY=

# ===== HTTPS =====
# 生产环境如果前面有 Nginx/Caddy 处理 HTTPS，设为 0
# 直接暴露 Flask 时保持 1（仅开发环境）
SKYTRACE_SECURE_COOKIES=1

# ===== 可选: GitHub 备份默认仓库 =====
# 管理员创建时可以继承此默认值
SKYTRACE_DEFAULT_BACKUP_REPO=
